{
  "name": "gladys-no-ip",
  "version": "0.1.0",
  "private": true,
  "description": "External Gladys Assistant integration for No-IP (dynamic DNS): keeps No-IP hostnames, groups or DDNS Keys pointed at the public IPv4 / IPv6 address of the home through the official No-IP update endpoint, with devices, scene triggers (public address changed, record updated, update failed), scene actions and a dashboard widget.",
  "homepage": "https://github.com/William-De71/gladys-no-ip",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-De71/gladys-no-ip.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  },
  "license": "Apache-2.0",
  "keywords": [
    "gladys-assistant",
    "gladys-assistant-integration",
    "no-ip",
    "noip",
    "dynamic-dns",
    "ddns",
    "home-automation"
  ]
}
